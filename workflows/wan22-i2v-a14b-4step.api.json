{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Wan 2.2 I2V A14B high noise"
    },
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Wan 2.2 I2V A14B low noise"
    },
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "3": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "lightx2v 4-step (high)"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "strength_model": 1
    }
  },
  "4": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "lightx2v 4-step (low)"
    },
    "inputs": {
      "model": [
        "2",
        0
      ],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "strength_model": 1
    }
  },
  "5": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "3",
        0
      ],
      "shift": 5
    }
  },
  "6": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "shift": 5
    }
  },
  "7": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "8": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    },
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "7",
        0
      ]
    }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    },
    "inputs": {
      "text": "{{negative_prompt}} 色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": [
        "7",
        0
      ]
    }
  },
  "11": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Source image"
    },
    "inputs": {
      "image": "{{source_image}}"
    }
  },
  "12": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": [
        "9",
        0
      ],
      "negative": [
        "10",
        0
      ],
      "vae": [
        "8",
        0
      ],
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{frames}}",
      "batch_size": 1,
      "start_image": [
        "11",
        0
      ]
    }
  },
  "13": {
    "class_type": "KSamplerAdvanced",
    "_meta": {
      "title": "High noise steps 0-2"
    },
    "inputs": {
      "model": [
        "5",
        0
      ],
      "add_noise": "enable",
      "noise_seed": "{{seed}}",
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "12",
        0
      ],
      "negative": [
        "12",
        1
      ],
      "latent_image": [
        "12",
        2
      ],
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable"
    }
  },
  "14": {
    "class_type": "KSamplerAdvanced",
    "_meta": {
      "title": "Low noise steps 2-4"
    },
    "inputs": {
      "model": [
        "6",
        0
      ],
      "add_noise": "disable",
      "noise_seed": "{{seed}}",
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "12",
        0
      ],
      "negative": [
        "12",
        1
      ],
      "latent_image": [
        "13",
        0
      ],
      "start_at_step": 2,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "14",
        0
      ],
      "vae": [
        "8",
        0
      ]
    }
  },
  "16": {
    "class_type": "SaveWEBM",
    "_meta": {
      "title": "WebM output"
    },
    "inputs": {
      "images": [
        "15",
        0
      ],
      "filename_prefix": "vediofactory/wan22-i2v-a14b",
      "codec": "vp9",
      "fps": "{{fps}}",
      "crf": 28
    }
  }
}
