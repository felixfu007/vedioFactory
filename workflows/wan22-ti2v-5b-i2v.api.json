{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Wan 2.2 TI2V-5B"
    },
    "inputs": {
      "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "UMT5-XXL text encoder"
    },
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Wan 2.2 VAE"
    },
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "12",
        0
      ],
      "shift": 8
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    },
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "2",
        0
      ]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    },
    "inputs": {
      "text": "{{negative_prompt}} 色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": [
        "2",
        0
      ]
    }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Source image"
    },
    "inputs": {
      "image": "{{source_image}}"
    }
  },
  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": [
        "3",
        0
      ],
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{frames}}",
      "batch_size": 1,
      "start_image": [
        "7",
        0
      ]
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": 5,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "8",
        0
      ],
      "denoise": 1
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "9",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "11": {
    "class_type": "SaveWEBM",
    "_meta": {
      "title": "WebM output"
    },
    "inputs": {
      "images": [
        "10",
        0
      ],
      "filename_prefix": "vediofactory/wan22-ti2v-5b",
      "codec": "vp9",
      "fps": "{{fps}}",
      "crf": 28
    }
  },
  "12": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Optional LoRA (removed by vedioFactory when no LoRA is selected)"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "{{lora_name}}",
      "strength_model": "{{lora_strength}}"
    }
  }
}
