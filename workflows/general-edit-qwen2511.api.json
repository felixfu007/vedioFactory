{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Qwen-Image-Edit-2511 (int8 convrot, Apache-2.0)"
    },
    "inputs": {
      "unet_name": "qwen_image_edit_2511_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen2.5-VL 7B text encoder (fp8)"
    },
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Qwen-Image VAE"
    },
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "4": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 3.1
    }
  },
  "5": {
    "class_type": "CFGNorm",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "strength": 1
    }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Lightning 4-step LoRA (lightx2v, Apache-2.0)"
    },
    "inputs": {
      "model": [
        "5",
        0
      ],
      "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
      "strength_model": 1
    }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Source photo (identity)"
    },
    "inputs": {
      "image": "{{source_image}}"
    }
  },
  "8": {
    "class_type": "FluxKontextImageScale",
    "_meta": {
      "title": "Scale source to ~1 MP"
    },
    "inputs": {
      "image": [
        "7",
        0
      ]
    }
  },
  "9": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": {
      "title": "Edit instruction (user prompt + identity/framing guidance)"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "image1": [
        "8",
        0
      ],
      "prompt": "Change the scene and pose: the same person from the image is now {{prompt}}. Keep the person exactly the same: identical face and facial features, same skin tone, same hairstyle and hair color, same outfit and shoes. Photorealistic natural photograph, vertical full-body shot, the whole person and everything they interact with (animal, vehicle, objects) fully in frame from head to toe with space above the head, face clearly visible and turned toward the camera, sharp detailed face, natural daylight, realistic proportions and anatomy."
    }
  },
  "10": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": {
      "title": "Negative (ignored at cfg 1, kept for non-Lightning runs)"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "image1": [
        "8",
        0
      ],
      "prompt": "{{negative_prompt}}"
    }
  },
  "11": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "conditioning": [
        "9",
        0
      ],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "12": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "conditioning": [
        "10",
        0
      ],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "13": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Output size (same aspect as the video, e.g. 720x1280 for 544x960)"
    },
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "6",
        0
      ],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "11",
        0
      ],
      "negative": [
        "12",
        0
      ],
      "latent_image": [
        "13",
        0
      ],
      "denoise": 1
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "14",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "16": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "First frame for stage 1",
      "vediofactory": {
        "stage": 0,
        "output": "image"
      }
    },
    "inputs": {
      "images": [
        "15",
        0
      ],
      "filename_prefix": "vediofactory/general-edit"
    }
  }
}
