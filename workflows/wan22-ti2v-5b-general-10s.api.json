  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive (user prompt + generic consistency guidance)"
    },
    "inputs": {
      "text": "{{prompt}} The same person from the first frame continues this action smoothly and continuously for the whole clip, with natural, realistic, physically plausible motion. Same face, same hairstyle and hair color, same outfit and shoes as in the first frame; the face stays clearly visible and turned mostly toward the camera, never covered by hair or objects. Animals, vehicles and objects keep a consistent shape, size and color with correct anatomy. The whole person stays in frame from head to feet with space above the head. Steady camera (a smooth tracking shot that keeps the person centered is fine), stable framing, no zoom, no sudden cuts, consistent lighting and background, realistic natural motion.",
      "clip": [
        "2",
        0
      ]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    },
    "inputs": {
      "text": "{{negative_prompt}} back to camera, hair covering face, face hidden by hair, face obscured, looking away, looking down, profile view, camera zoom, zoom in, shaky camera, sudden camera movement, close-up, cropped feet, cropped head, out of frame, flicker, changing outfit, changing hairstyle, different person, face change, morphing, extra limbs, extra arms, extra legs, deformed animal, animal with extra legs, merged bodies, frozen, slow motion, nsfw, revealing clothing, 色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": [
        "2",
        0
      ]
    }
  },
