# 複製成 .env 後依自己的電腦修改；docker compose 會自動讀取 .env。
# .env 內容只屬於這台電腦（含 Civitai 金鑰），不會被加入 git。

# 影片庫：和直接執行 npm start 時相同的資料夾
VEDIO_FACTORY_HOST_OUTPUT_DIR=C:/Users/<你的帳號>/Videos/vedioFactory
# 參數預設等應用資料
VEDIO_FACTORY_HOST_DATA_DIR=C:/Users/<你的帳號>/vedioFactory
# ComfyUI 的 models 資料夾（從 Civitai 安裝模型時寫入這裡）
VEDIO_FACTORY_HOST_COMFYUI_MODELS_DIR=C:/Users/<你的帳號>/ComfyUI/models

# 網站在主機上的連接埠
VEDIO_FACTORY_PORT=8000

# 透過 Tailscale 連線時使用的主機名稱（逗號分隔）
VEDIO_FACTORY_ALLOWED_HOSTS=<電腦名稱>.<tailnet>.ts.net

# 選用：Civitai API 金鑰（下載需要登入的模型時才需要）
VEDIO_FACTORY_CIVITAI_TOKEN=
