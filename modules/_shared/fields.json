{
  "schemaVersion": 1,
  "fields": {
    "camera": {
      "label": "鏡頭遠近",
      "type": "select",
      "options": ["遠景全身", "中景半身", "近景胸像", "臉部特寫"],
      "default": "中景半身",
      "help": "要看清楚表情請選中景以內；要看完整動作請選遠景全身。"
    },
    "angle": {
      "label": "拍攝角度",
      "type": "select",
      "options": ["正面", "側面", "斜側 45 度", "低角度仰拍", "高角度俯拍"],
      "default": "正面"
    },
    "movement": {
      "label": "運鏡",
      "type": "select",
      "options": ["固定機位", "鏡頭緩慢推近", "鏡頭緩慢拉遠", "鏡頭環繞人物", "鏡頭跟隨人物移動"],
      "default": "固定機位",
      "help": "人物動作大時選固定機位，畫面最穩定。"
    },
    "person": {
      "label": "人物",
      "type": "text",
      "default": "一位二十多歲的亞洲女性",
      "help": "寫年齡、性別、髮型等外型；不要寫真實人物姓名。"
    },
    "outfit": {
      "label": "穿著",
      "type": "text",
      "default": "簡約的白色上衣與深色長褲",
      "help": "顏色、款式、材質寫得越具體越準確。"
    },
    "expression": {
      "label": "臉部表情",
      "type": "select",
      "options": ["自信的微笑", "開心地大笑", "專注認真", "溫柔平靜", "堅定有力", "驚喜興奮"],
      "default": "自信的微笑"
    },
    "lighting": {
      "label": "光線",
      "type": "select",
      "options": ["明亮自然光", "柔和攝影棚燈光", "戲劇性側光", "黃金時段夕陽光", "舞台聚光燈", "霓虹燈光"],
      "default": "柔和攝影棚燈光"
    },
    "style": {
      "label": "畫面風格",
      "type": "select",
      "options": ["電影感", "時尚雜誌質感", "商業廣告質感", "紀實攝影風格", "溫暖生活感"],
      "default": "商業廣告質感"
    }
  }
}
