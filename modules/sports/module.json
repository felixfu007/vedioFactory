{
  "schemaVersion": 1,
  "id": "sports",
  "name": "體育競技影片",
  "description": "運動員比賽或訓練的競技短片：可指定運動項目、關鍵動作、場地與拍攝方式。",
  "version": "1.0.0",
  "tags": [
    "人物",
    "運動",
    "競技"
  ],
  "workflow": {
    "file": "workflow.json",
    "description": "Wan 2.2 TI2V 5B 文生影片，原生 24 FPS；16GB 顯示卡建議 5 秒以內。",
    "videoModelIds": [
      "wan-2.2-ti2v-5b"
    ],
    "requiresSourceImage": false,
    "resolutions": [
      "1280x704",
      "704x1280",
      "960x544",
      "544x960"
    ],
    "allowCustomResolution": true,
    "resolutionMultiple": 32,
    "maxWidth": 1280,
    "maxHeight": 1280,
    "fps": [
      24
    ],
    "minDuration": 2,
    "maxDuration": 5,
    "name": "體育競技影片（Wan 2.2 文生影片）",
    "defaults": {
      "resolution": "1280x704",
      "fps": 24,
      "duration": 5
    }
  },
  "fields": [
    {
      "use": "camera",
      "default": "遠景全身"
    },
    {
      "use": "angle",
      "default": "側面"
    },
    {
      "use": "movement",
      "default": "鏡頭跟隨人物移動"
    },
    {
      "use": "person",
      "label": "運動員",
      "default": "一位職業運動員"
    },
    {
      "use": "outfit",
      "default": "紅色運動背心與短褲"
    },
    {
      "use": "expression",
      "default": "堅定有力"
    },
    {
      "name": "sport",
      "label": "運動項目",
      "type": "select",
      "options": [
        "在跑道上短跑衝刺",
        "籃球運球後上籃",
        "足球盤球後射門",
        "網球發球",
        "游泳自由式",
        "排球跳起扣球"
      ],
      "default": "在跑道上短跑衝刺"
    },
    {
      "name": "action",
      "label": "關鍵時刻",
      "type": "select",
      "options": [
        "全力衝刺的瞬間",
        "以慢動作展示關鍵動作",
        "完成動作後振臂歡呼"
      ],
      "default": "全力衝刺的瞬間"
    },
    {
      "name": "scene",
      "label": "場地",
      "type": "select",
      "options": [
        "專業田徑場",
        "室內籃球場",
        "綠茵足球場",
        "網球場",
        "室內游泳池",
        "體育館"
      ],
      "default": "專業田徑場"
    },
    {
      "use": "lighting",
      "default": "明亮自然光"
    },
    {
      "use": "style",
      "options": [
        "運動廣告質感",
        "電影感慢動作",
        "紀實攝影風格"
      ],
      "default": "運動廣告質感"
    }
  ],
  "preset": {
    "description": "體育競技影片，橫式 5 秒。",
    "promptTemplate": "{camera}、{angle}、{movement}，{person}穿著{outfit}，在{scene}{sport}，{action}，表情{expression}，動作有力且速度感強，{lighting}，{style}，高畫質",
    "storyTemplate": "{person}在{scene}{sport}，{action}。",
    "negativePrompt": "色調艷麗，過曝，靜態，細節模糊不清，字幕，浮水印，風格化，畫作，靜止不動，整體發灰，最差品質，低品質，JPEG 壓縮殘留，醜陋的，殘缺的，多餘的手指，畫得不好的手部，畫得不好的臉部，畸形的，毀容的，形態畸形的肢體，手指融合，雜亂的背景，三條腿，背景人很多，倒著走",
    "videoModelId": "wan-2.2-ti2v-5b",
    "seedMode": "random",
    "settings": {
      "resolution": "1280x704",
      "fps": 24,
      "duration": 5,
      "quality": "premium",
      "motion": 60,
      "captionStrength": 40
    }
  },
  "example": {
    "variables": {
      "camera": "遠景全身",
      "angle": "側面",
      "movement": "鏡頭跟隨人物移動",
      "person": "一位職業運動員",
      "outfit": "紅色運動背心與短褲",
      "expression": "堅定有力",
      "sport": "在跑道上短跑衝刺",
      "action": "全力衝刺的瞬間",
      "scene": "專業田徑場",
      "lighting": "明亮自然光",
      "style": "運動廣告質感"
    },
    "seed": 20261105
  },
  "safety": {
    "requiresPersonConsent": true,
    "notes": "畫面中的人物由 AI 虛構；提示詞不要寫入真實藝人或公眾人物的姓名。若加入真人照片作為來源，必須取得本人同意，且不得用於冒充、誤導或任何不雅內容。"
  }
}
